# このファイルをコピーして .env.local を作り、値を設定します。
# .env.local はGitに含めません。

# データベース
# 開発中は file:local.db でローカルのファイルを使えます。
# Tursoを使うときは libsql://... のURLに置き換えます。
TURSO_DATABASE_URL=file:local.db
# ローカルのファイルを使うときは空のままで構いません。
TURSO_AUTH_TOKEN=

# Better Auth（フェーズ2で使用）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Googleログイン（フェーズ2で使用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 管理者のメールアドレス（フェーズ2で使用）
ADMIN_EMAIL=
